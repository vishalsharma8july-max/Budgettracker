rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only people who are signed in (i.e. accounts you created yourself
    // in the Firebase console) can read or write transactions.
    // Since there is no sign-up form in the app, the only accounts that
    // exist are the ones you add manually — that's what limits access.
    match /transactions/{transactionId} {
      allow read, write: if request.auth != null;
    }

    // Everything else is locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
